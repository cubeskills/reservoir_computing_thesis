# --- Virtual Environment ---
# Ignore the virtual environment folder
.venv/

# --- Python Cache & Compiled Files ---
# Ignore the Python cache folder
__pycache__/
# Ignore compiled Python files
*.pyc
*.pyo
*.pyd

# --- Distribution / Packaging ---
# Ignore build artifacts
build/
dist/
*.egg-info/
*.egg

# --- Editor & OS Specific ---
# Ignore common IDE/editor folders
.vscode/
.idea/
# Ignore macOS specific files
.DS_Store
# Ignore Windows specific files
Thumbs.db

# --- Temporary Files & Logs ---
# Ignore log files
*.log
# Ignore temporary files created by some libraries
*.tmp

# --- Data Files ---
# Ignore large CSV result files
data/*.csv
!data/.gitkeep
!data/README.md

# --- Figures & Plots ---
# Ignore generated plots and figures
figures/*.pdf
figures/*.png
figures/*.jpg
figures/*.svg
!figures/.gitkeep
!figures/README.md

# --- Research Specific ---
# Ignore model checkpoints and serialized objects
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Ignore experiment results and checkpoints
results/
experiments/
checkpoints/

# --- Jupyter Notebooks ---
# Ignore notebook checkpoints
.ipynb_checkpoints

# --- Additional Python ---
# More comprehensive Python ignores
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
MANIFEST

# --- Virtual Environments (Extended) ---
venv/
env/
ENV/
.env

# --- Coverage & Testing ---
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# --- Profiling ---
.prof
